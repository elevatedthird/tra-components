<div class="glide__bullets {{ classes.bullets }}" data-glide-el="controls[nav]">
  {% for i in 0..item_count - 1 %}
    <button class="glide__bullet" aria-controls="slide-{{ i }}" data-glide-dir="={{ loop.index0 }}" aria-label="{{ 'Slide ' ~ i ~ ' of ' ~  (item_count - 1)  }}"></button>
  {% endfor %}
</div>
