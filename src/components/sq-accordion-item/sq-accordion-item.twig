{% set accordion_item_id = id ? id : title|render|striptags|trim|clean_class %}

<div class="molecule--sq-accordion-item accordion-item position-relative" data-accordion-item>
  {# Accordion Item Header #}
  {% if title %}
    <a href="#acc--{{ accordion_item_id }}"
       class="molecule--accordion-item--header flex-container align-middle position-relative trim-bottom-margin material-symbols-outlined expand-more text-decoration--none">
      {% if icon|render %}
        <div class="molecule--accordion-item--icon {{ icon_color ? 'icon-color--' ~ icon_color }}">
          {{ icon }}
        </div>
      {% endif %}
      <div class="molecule--accordion-item--title-wrapper">
        <h3 class="molecule--accordion-item--title {{ title_typography }} {{ text_color ? 'text-color-' ~ text_color }}">
          {{ title }}
        </h3>
        {% if subtitle|render %}
          <p class="molecule--accordion-item--subtitle">
            {{ subtitle }}
          </p>
        {% endif %}
      </div>
    </a>
  {% endif %}

  {# Accordion Item Content #}
  <div class="accordion-content mb-2 large-mb-5 border-none" data-tab-content id="acc--{{ accordion_item_id }}">

    {% if description %}
      <div class="molecule--accordion-item--description body-l">
        {{ description }}
      </div>
    {% endif %}

    {% if links|render %}
      <div class="organism--accordion--link-wrapper">
        {# only tertiary buttons or links allowed #}
        {{ links }}
      </div>
    {% endif %}
    <div class="disclosure-wrapper">
      {% if disclosure %}
        <div class="tooltip-admin tooltip-admin-hidden" aria-hidden="true">{{ disclosure }}</div>
      {% endif %}
      {% if disclosure|render %}
        {% include '{{sequoia}}:sq-tooltip' with {
          text: disclosure,
        } %}
      {% endif %}
    </div>
  </div>
</div>
