<div class="molecule--sq-multi-stat-item sub-section flex-container align-middle {{ background_color ? 'bg-color-' ~ background_color }}">
  <div class="inner-wrapper">
    {% if heading %}
      <{{ heading_tag|default('h2') }} class="heading {{ heading_font_size|default('h2')}}"
    {% if heading_id %}
      id="{{ heading_id }}"
    {% endif %}
      >{{ heading }}</{{ heading_tag|default('h2') }}>
    {% endif %}
    {% if description %}
      <div class="description mt-4 {{ description_font_size|default('body-l')}}">{{ description }}</div>
    {% endif %}
    {% if disclosure %}
      {% include '{{sequoia}}:sq-tooltip' with {
        text: disclosure,
        classes: ['mt-4']
      } %}
    {% endif %}
  </div>
</div>
