<div class="molecule--sq-multi-stat-item sub-section flex-container align-middle">
  <div class="inner-wrapper">
    {% if heading %}
      <h3 class="heading h1"
          {% if heading_id %}
            id="{{ heading_id }}"
          {% endif %}
      >{{ heading }}</h3>
    {% endif %}
    {% if description %}
      <div class="description mt-4 body-m">{{ description }}</div>
    {% endif %}
    {% if disclosure %}
      {% include 'aries:sq-tooltip' with {
        text: disclosure,
        classes: ['mt-4']
      } %}
    {% endif %}
  </div>
</div>
