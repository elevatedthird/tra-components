<div class="organism--sq-tabs aries-tabs-wrapper">
  {% if heading %}
    <h2 class="organism--tabs-heading h2">{{ heading }}</h2>
  {% endif %}
  {% if description %}
    <div class="organism--tabs-description body-l">
      {{ description }}
    </div>
  {% endif %}
  {% if tab_labels %}
    {% if dropdown_label %}
      <div class="tab-dropdown-label body-l">{{ dropdown_label }}</div>
    {% endif %}
    <div class="tab-list" data-no-scroll-breakpoint="{{ no_scroll_breakpoint|default(600) }}" data-dropdown-breakpoint="{{ dropdown_breakpoint|default(600) }}">
      <ul role="tablist" class="sq-tabs__tab-list">
        {#  The left spacer was present in the tab slider version but seemed not needed. add an arg to turn on if we find we do need it.  #}
        {#    <li aria-hidden="true" class="ul-spacers ul-spacer--left"></li>#}
        {% for tab_label in tab_labels %}
          <li role="presentation"><a href="#tab--{{ tab_label|clean_class }}" role="tab" aria-controls="{{ tab_label|clean_class }}" class="aries-tabs__trigger js-tab-trigger" data-text="{{ tab_label }}">{{ tab_label }}</a></li>
        {% endfor %}
        <li aria-hidden="true" class="ul-spacers ul-spacer--right"></li>
      </ul>
      <button class="move-list move-list-left material-symbols-outlined disabled" data-direction="left">chevron_left</button>
      <button class="move-list move-list-right material-symbols-outlined" data-direction="right">chevron_right</button>
    </div>
  {% endif %}
  <div class="tab-items">
    {{ tabs }}
  </div>
</div>
