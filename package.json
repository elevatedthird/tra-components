{
  "name": "tra-components",
  "version": "2.0.18",
  "description": "Sequoia CSS library with global styles, components, and assets",
  "main": "dist/css/global.css",
  "files": [
    "dist/**/*",
    "src/**/*",
    "tokens/**/*",
    "README.md"
  ],
  "bin": {
    "sequoia-sync": "./scripts/sync-components.js"
  },
  "scripts": {
    "tokens": "style-dictionary build --config style-dictionary.config.mjs",
    "validate-tokens": "node scripts/validate-tokens.mjs",
    "prebuild": "npm run validate-tokens && npm run tokens",
    "build": "webpack --config webpack.config.js --mode=production",
    "test": "vitest --run",
    "sync:components": "node scripts/sync-components.js",
    "sync:figma": "node scripts/sync-figma-variables.mjs",
    "sync:figma:dry": "node scripts/sync-figma-variables.mjs --dry-run",
    "pull:figma": "node scripts/pull-figma-variables.mjs",
    "pull:figma:dry": "node scripts/pull-figma-variables.mjs --dry-run",
    "prepublishOnly": "npm install && npm run build"
  },
  "keywords": [
    "css",
    "scss",
    "styles",
    "sequoia",
    "transamerica",
    "foundation"
  ],
  "author": "Transamerica",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://bitbucket.shared.ta.aegon.io/scm/TAINDIVIDUAL/transamerica.individual.technology.sequoiadds.git"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@glidejs/glide": "^3.7.1",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "fast-check": "^4.6.0",
    "foundation-sites": "^6.9.0",
    "glob": "^11.0.3",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "sass": "^1.58.0",
    "sass-loader": "^13.2.0",
    "style-dictionary": "^4.4.0",
    "vitest": "^2.1.9",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-remove-empty-scripts": "^1.1.1"
  }
}
